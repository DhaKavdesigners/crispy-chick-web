{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/rider",
      "destination": "/rider.html"
    },
    {
      "source": "/counter",
      "destination": "/counter.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
