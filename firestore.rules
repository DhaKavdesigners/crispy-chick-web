rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Settings & Store Hours — anyone can read/write so counter operator can manage menu & store hours
    match /settings/{docId} {
      allow read, write: if true;
    }

    // 2. Orders Collection
    // - Customers create orders: must start as 'pending', minimum bill ₹30, valid items list & valid phone
    // - Price Lock: totalAmount CANNOT be modified once an order has been created
    // - Valid Status: status can only transition to recognized food delivery lifecycle states
    match /orders/{orderId} {
      allow create: if request.resource.data.totalAmount >= 30
                    && request.resource.data.status == 'pending'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() >= 10;
      allow read: if true;
      allow update: if request.resource.data.totalAmount == resource.data.totalAmount
                    && request.resource.data.status in ['pending', 'preparing', 'prepared', 'out_for_delivery', 'arrived', 'delivered', 'successfully_delivered', 'rejected', 'cancelled'];
      allow delete: if true;
    }

    // 3. Riders Fleet — open read/write so riders can toggle online status & counter can manage fleet
    match /riders/{riderId} {
      allow read, write: if true;
    }

    // 4. User Profiles, Addresses & Ban status
    match /users/{phone} {
      allow read, write: if true;
    }
  }
}
